#!/bin/sh
# Installed by scripts/install-ui-hook.mjs; Graphify's other hooks stay intact.
task_root=$(git rev-parse --show-toplevel) || exit 1
if test -f "$task_root/scripts/check-ui-components.mjs"; then
  node "$task_root/scripts/check-ui-components.mjs" --staged || exit $?
fi
if test -x "$(git rev-parse --git-path hooks)/pre-commit.before-ui"; then
  "$(git rev-parse --git-path hooks)/pre-commit.before-ui" "$@" || exit $?
fi
