        "dialogs": [
          {
            "cancel": false,
            "lines": [
              "{Emokon, part 1 -} \n{The quest for Adventure v1.1}\n\n{Playtesters:}\n{Fnord}\n{Simon Mooncalf}\n"
            ],
            "queryId": -1,
            "title": "Game message",
