    {
      "source": "new-towns-config.cpp:595..601",
      "fact": "For index0..63, BuildingCost(index+64) parses seven integers into new_buildings_cost[town][index][0..6], with optional separate eighth Mithril field."
    },
    {
      "source": "new-towns-config.cpp:82..",
      "fact": "ParseStr uses strstr and selects first substring, including commented tokens. Strict importer rejects duplicates/noncanonical ambiguity."
    },
    {
      "source": "h3-constants.hpp:766..778",
      "fact": "NH3Resources order is wood,mercury,ore,sulfur,crystal,gems,gold."
    },
    {
      "binary": "10016803..100168D7",
      "fact": "Formats index+64, iterates seven resources, destination base100A2FF0 +town*0x700 +index*0x1C +resource*4."
    },
    {
      "binary": "1000DD80..1000DDBF",
      "fact": "Integer extraction writes through destination, including mov ecx,(eax) at1000DDAD. Valid values replace rather than add."
    },
    {
      "binary": "100168D9..100168F3",
      "fact": "Optional eighth value is parsed separately into Mithril requirements."
    },
    {
      "binary": "1002FB40..1002FB9F",
      "fact": "For building64..127, original hook005BF811 substitutes pointer to same full seven-resource table and continues005BF84C."
    },
    {
      "source": "new-towns-hooks.cpp:1367..1387",
      "fact": "can_afford_new_building compares each of seven player resource counts against direct table costs."
    },
    {
      "source": "new-towns-hooks.cpp:2075..2102",
      "fact": "Town_AIBuildingBuilt_hook subtracts exactly the seven table elements after affordability; no normalization or extra cost added."
    },
    {
      "source": "new-towns-hooks.cpp:2146..2154",
      "fact": "town_GetResourcesRequirements_hook copies28bytes, seven signed32-bit elements."
    },
    {
      "native": "lib/entities/faction/CTownHandler.cpp:284 +lib/ResourceSet.cpp:41..48",
      "fact": "Native building resources resolve from cost dictionary. Emitting all seven explicit zeros prevents obsolete dictionary components surviving merge."
    }
