          "minLength": 1
        },
        "currentSourceHashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "coveredBy": {
          "$ref": "#/$defs/indexAttestation/properties/evidence"
        }
      }
    },
    "indexAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed",
        "scope",
        "evidence"
      ],
      "properties": {
        "reviewed": {
          "const": true
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "pointer",
              "expected",
              "assertion"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "pointer": {
                "type": "string"
              },
              "expected": {},
              "assertion": {
                "type": "string",
                "minLength": 1
              },
              "sourceId": {
                "type": "integer",
                "minimum": 0
              },
              "bankId": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
