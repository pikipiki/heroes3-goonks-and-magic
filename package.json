{
  "name": "heroes-goonk",
  "version": "0.4.267",
  "private": true,
  "scripts": {
    "start": "cd work/browser-tests && node server.mjs",
    "build:mod": "cd work/browser-tests && node build-goonk.mjs",
    "test": "npm run build:ui && node --test tests/*.test.mjs",
    "prepare:web": "node scripts/prepare-web.mjs",
    "build:web": "npm run build:ui && node scripts/build-site.mjs",
    "verify:web": "node scripts/verify-site.mjs",
    "package:web": "npm run prepare:web && npm run build:web && npm run verify:web && node scripts/package-site.mjs",
    "pack:game-data": "node scripts/pack-game-data.mjs",
    "audit:era": "node scripts/era-bridge/cli.mjs audit ../Third-Upgrade-Mod-Full outputs/era-bridge-audit.json",
    "audit:compatibility": "node scripts/era-bridge/compatibility/build.mjs",
    "check:ui": "node scripts/check-ui-components.mjs --staged",
    "install:ui-hook": "node scripts/install-ui-hook.mjs",
    "build:ui": "node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1"
  }
}
