{
  "adventureCache": {
    "name": "Travellers’ cache",
    "handler": "configurable",
    "types": {
      "adventureCache": {
        "name": "Travellers’ cache",
        "description": "@goonk.adventure.adventureCache.description",
        "selectMode": "selectPlayer",
        "visitMode": "once",
        "canRefuse": true,
        "showScoutedPreview": true,
        "onSelectMessage": "@goonk.adventure.adventureCache.select",
        "onVisitedMessage": "@goonk.adventure.adventureCache.visited",
        "onEmptyMessage": "@goonk.adventure.adventureCache.empty",
        "rewards": [
          {
            "description": "@goonk.adventure.cache.gold",
            "resources": {
              "gold": 1500
            },
            "removeObject": true
          },
          {
            "description": "@goonk.adventure.cache.xp",
            "heroExperience": 1000,
            "removeObject": true
          },
          {
            "description": "@goonk.adventure.cache.mana",
            "manaPoints": 15,
            "manaOverflowFactor": 0,
            "removeObject": true,
            "limiter": {
              "noneOf": [
                {
                  "manaPercentage": 100
                }
              ]
            }
          }
        ],
        "rmg": {
          "value": 3000,
          "rarity": 40,
          "zoneLimit": 1
        },
        "templates": {
          "normal": {
            "animation": "AVTchst0.def",
            "mask": [
              "A"
            ],
            "visitableFrom": [
              "+++",
              "+-+",
              "+++"
            ]
          }
        }
      }
    }
  },
